<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxe Locks Hair Studio</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-cream: #F5EFEB;
            --olive-header: #8E9873;
            --olive-dark: #687152;
            --text-main: #333333;
            --pink-accent: #E8B4B8;
            --glass-bg: rgba(255, 255, 255, 0.75);
            --card-bg: #EFE7E0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background-color: var(--bg-cream);
            color: var(--text-main);
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* Fade-in Animation Classes */
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }
        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Top Announcement Bar */
        .top-bar {
            background-color: var(--olive-header);
            color: white;
            text-align: center;
            font-size: 0.85rem;
            padding: 8px 0;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        /* Navigation Header */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 6%;
            background-color: var(--bg-cream);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: #2c2c2c;
            text-decoration: none;
        }

        .logo-area span {
            font-style: italic;
            font-weight: 400;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 35px;
        }

        nav ul li a {
            text-decoration: none;
            color: var(--text-main);
            font-size: 0.95rem;
            font-weight: 500;
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: var(--olive-dark);
        }

        .book-btn-nav {
            background-color: var(--olive-header);
            color: white;
            padding: 10px 22px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            transition: background 0.3s;
        }

        .book-btn-nav:hover {
            background-color: var(--olive-dark);
        }

        /* Hero Section */
        .hero {
            position: relative;
            padding: 40px 6% 100px 6%;
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            align-items: center;
            gap: 40px;
        }

        .hero-content h3 {
            font-size: 0.85rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #777;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .hero-content h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3.8rem;
            line-height: 1.15;
            color: #2b2b2b;
            margin-bottom: 20px;
        }

        .hero-content h1 span {
            font-style: italic;
            font-weight: 400;
            color: #9a6d70;
        }

        .hero-content p {
            font-size: 1rem;
            color: #666;
            margin-bottom: 30px;
            max-width: 450px;
            line-height: 1.6;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
            align-items: center;
            margin-bottom: 35px;
        }

        .btn-primary {
            background-color: var(--olive-header);
            color: white;
            padding: 14px 28px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            border: none;
            cursor: pointer;
            transition: background 0.3s;
        }

        .btn-primary:hover {
            background-color: var(--olive-dark);
        }

        .btn-outline {
            background: transparent;
            color: var(--text-main);
            border: 1px solid var(--pink-accent);
            padding: 14px 28px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-outline:hover {
            background: var(--pink-accent);
            color: white;
        }

        .social-proof {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .client-avatars {
            display: flex;
        }

        .client-avatars img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 2px solid white;
            margin-left: -10px;
            object-fit: cover;
        }
        .client-avatars img:first-child {
            margin-left: 0;
        }

        .proof-text {
            font-size: 0.85rem;
            font-weight: 600;
        }

        .stars {
            color: #e5a93b;
            font-size: 0.8rem;
        }

        /* Hero Image Layout matching image */
        .hero-image-container {
            position: relative;
            display: flex;
            justify-content: center;
        }

        .hero-image-wrapper {
            width: 100%;
            max-width: 480px;
            height: 480px;
            border-radius: 50% 50% 30% 30% / 60% 60% 40% 40%;
            overflow: hidden;
            position: relative;
            background: #e2d7cc;
        }

        .hero-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Wave separator background curve */
        .wave-section {
            background-color: white;
            position: relative;
            padding: 80px 6%;
            border-radius: 50px 50px 0 0;
        }

        /* Services & Booking Grid Section */
        .services-booking-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 50px;
            align-items: start;
        }

        .section-header-title h4 {
            font-size: 0.8rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #888;
            margin-bottom: 8px;
        }

        .section-header-title h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            margin-bottom: 25px;
            color: #2b2b2b;
        }
        .section-header-title h2 span {
            font-style: italic;
            color: #9a6d70;
            font-weight: 400;
        }

        .cards-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .service-card {
            background-color: var(--card-bg);
            border-radius: 20px;
            overflow: hidden;
            text-align: center;
            padding-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            transition: transform 0.3s;
        }

        .service-card:hover {
            transform: translateY(-5px);
        }

        .service-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .service-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
            margin: 15px 0 5px 0;
        }

        .service-card p {
            font-size: 0.8rem;
            color: #666;
            padding: 0 10px;
            margin-bottom: 15px;
        }

        .price-tag {
            background-color: white;
            display: inline-block;
            padding: 6px 20px;
            border-radius: 15px;
            font-weight: 700;
            font-size: 0.95rem;
            color: #444;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        /* Glassmorphism Appointment Form */
        .glass-form-card {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            padding: 30px;
            border-radius: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        }

        .glass-form-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.4rem;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border-radius: 12px;
            border: 1px solid #ddd;
            background: white;
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.3s;
        }

        .form-control:focus {
            border-color: var(--olive-header);
        }

        .submit-appointment-btn {
            width: 100%;
            background-color: var(--olive-header);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            transition: background 0.3s;
            margin-top: 5px;
        }

        .submit-appointment-btn:hover {
            background-color: var(--olive-dark);
        }

        .form-footer-note {
            text-align: center;
            font-size: 0.75rem;
            color: #777;
            margin-top: 12px;
        }

        /* Interactive Features Section (AI preview, Before/After Slider, Calendar, Tour, Loyalty) */
        .interactive-showcase {
            background-color: var(--bg-cream);
            padding: 80px 6%;
        }

        .showcase-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
            margin-top: 40px;
        }

        .feature-box {
            background: white;
            padding: 35px;
            border-radius: 24px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.03);
        }

        .feature-box h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            margin-bottom: 15px;
            color: #333;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .feature-box h3 i {
            color: var(--olive-header);
            font-size: 1.2rem;
        }

        .feature-box p {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 20px;
        }

        /* Before & After Image Slider Component */
        .ba-slider-container {
            position: relative;
            width: 100%;
            height: 250px;
            border-radius: 15px;
            overflow: hidden;
            user-select: none;
        }

        .ba-image-before, .ba-image-after {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            object-fit: cover;
        }

        .ba-image-after-wrapper {
            position: absolute;
            top: 0; left: 0;
            width: 50%; height: 100%;
            overflow: hidden;
            border-right: 2px solid white;
        }

        .ba-image-after-wrapper img {
            width: 500px; /* matches container width approx */
            height: 100%;
            object-fit: cover;
        }

        .ba-slider-range {
            position: absolute;
            bottom: 15px;
            left: 5%;
            width: 90%;
            accent-color: var(--olive-header);
            cursor: pointer;
        }

        /* AI Hairstyle Selector */
        .ai-options {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
            overflow-x: auto;
            padding-bottom: 5px;
        }

        .ai-chip {
            padding: 8px 16px;
            background: var(--bg-cream);
            border: 1px solid #ddd;
            border-radius: 20px;
            font-size: 0.85rem;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.3s;
        }

        .ai-chip.active, .ai-chip:hover {
            background: var(--olive-header);
            color: white;
            border-color: var(--olive-header);
        }

        .ai-preview-screen {
            background: #222;
            border-radius: 15px;
            height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            position: relative;
            overflow: hidden;
        }

        .ai-preview-screen img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.85;
        }

        .ai-badge-overlay {
            position: absolute;
            bottom: 15px;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(5px);
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
        }

        /* Loyalty Points Tracker */
        .loyalty-card-box {
            background: linear-gradient(135deg, #8E9873, #687152);
            color: white;
            border-radius: 16px;
            padding: 20px;
            text-align: center;
        }

        .loyalty-score {
            font-size: 2.5rem;
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            margin: 10px 0;
        }

        /* Features Footer Banner icons row matching original design */
        .features-banner {
            background-color: var(--olive-header);
            color: white;
            padding: 50px 6%;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            text-align: center;
        }

        .feature-item i {
            font-size: 1.8rem;
            margin-bottom: 15px;
            color: #f7e1d7;
        }

        .feature-item h4 {
            font-size: 1.05rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .feature-item p {
            font-size: 0.8rem;
            line-height: 1.5;
            opacity: 0.9;
        }

        /* Main Footer Section */
        footer {
            background-color: #586142;
            color: white;
            padding: 60px 6% 30px 6%;
            text-align: center;
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.15);
            padding-bottom: 40px;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .footer-brand {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
        }

        .social-links {
            display: flex;
            gap: 15px;
        }

        .social-links a {
            background: rgba(255,255,255,0.15);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-decoration: none;
            transition: background 0.3s;
        }

        .social-links a:hover {
            background: white;
            color: var(--olive-dark);
        }

        .copyright {
            font-size: 0.8rem;
            opacity: 0.7;
        }

        /* Floating WhatsApp & Booking Button */
        .floating-action-container {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 999;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .floating-btn {
            background-color: #25D366;
            color: white;
            width: 55px;
            height: 55px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            text-decoration: none;
            transition: transform 0.3s;
        }

        .floating-btn.whatsapp {
            background-color: #25D366;
        }

        .floating-btn.book {
            background-color: var(--olive-header);
            font-size: 1.1rem;
            width: auto;
            padding: 0 20px;
            border-radius: 30px;
            font-weight: 600;
        }

        .floating-btn:hover {
            transform: scale(1.08);
        }

        /* Responsive Design */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <!-- Top Announcement Bar -->
    <div class="top-bar">
        🎀 BOOK YOUR APPOINTMENT TODAY & FEEL YOUR BEST 🎀
    </div>

    <!-- Navigation Header -->
    <header class="fade-in">
        <a href="#" class="logo-area">
            <i class="fa-solid fa-bow-string" style="color: #e8b4b8; font-size: 1.2rem;"></i> Luxe Locks <span>HAIR STUDIO +</span>
        </a>
        <nav>
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#services">Services</a></li>
                <li><a href="#interactive">AI Preview</a></li>
                <li><a href="#about">About Us</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
        <a href="#book-section" class="book-btn-nav">Book Now</a>
    </header>

    <!-- Hero Section -->
    <section class="hero fade-in" id="home">
        <div class="hero-content">
            <h3>Beauty. Confidence. You. 🤍</h3>
            <h1>Where Beauty Meets <span>Confidence*</span></h1>
            <p>Luxury hair care services designed to make you look and feel your absolute best. 💇‍♀️</p>
            
            <div class="hero-buttons">
                <a href="#book-section" class="btn-primary">Book Your Appointment 🎀</a>
                <a href="#services" class="btn-outline">View Services</a>
            </div>

            <div class="social-proof">
                <div class="client-avatars">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100" alt="Client">
                    <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100" alt="Client">
                    <img src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=100" alt="Client">
                </div>
                <div>
                    <div class="proof-text">500+ Happy Clients</div>
                    <div class="stars">
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="hero-image-container">
            <!-- Exact match layout image from user's picture showing the lady getting her hair styled with pink cape and neon sign ambiance -->
            <div class="hero-image-wrapper">
                <img src="https://images.unsplash.com/photo-1562322140-8baeececf3df?w=800" alt="Luxury Hair Styling Experience">
            </div>
        </div>
    </section>

    <!-- Main Content Wave Wrapper Section -->
    <div class="wave-section">
        <div class="services-booking-grid fade-in" id="services">
            
            <!-- Left Side: Services Showcase -->
            <div>
                <div class="section-header-title">
                    <h4>Our Services 🤍</h4>
                    <h2>Treat Your Hair to the <span>Best*</span></h2>
                </div>

                <div class="cards-row">
                    <!-- Service 1 -->
                    <div class="service-card">
                        <img src="https://images.unsplash.com/photo-1519699047748-de8e457a634e?w=400" alt="Sew-In Weave" class="service-img">
                        <h3>Sew-In Weave</h3>
                        <p>Natural. Flawless. Beautiful.</p>
                        <div class="price-tag">R650</div>
                    </div>

                    <!-- Service 2 -->
                    <div class="service-card">
                        <img src="https://images.unsplash.com/photo-1580618672591-eb180b1a973f?w=400" alt="Braids" class="service-img">
                        <h3>Braids</h3>
                        <p>Neat. Stylish. Long-lasting.</p>
                        <div class="price-tag">R500</div>
                    </div>

                    <!-- Service 3 -->
                    <div class="service-card">
                        <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=400" alt="Hair Coloring" class="service-img">
                        <h3>Hair Coloring</h3>
                        <p>Vibrant color. Stunning you.</p>
                        <div class="price-tag">R700</div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Glassmorphism Appointment Form -->
            <div class="glass-form-card" id="book-section">
                <h3>Book Your Appointment 🎀</h3>
                <form id="bookingForm" onsubmit="handleBooking(event)">
                    <div class="form-group">
                        <input type="text" class="form-control" placeholder="👤 Your Name" required>
                    </div>
                    <div class="form-group">
                        <input type="tel" class="form-control" placeholder="📞 Phone Number" required>
                    </div>
                    <div class="form-group">
                        <select class="form-control" required>
                            <option value="">✨ Select Service</option>
                            <option value="weave">Sew-In Weave (R650)</option>
                            <option value="braids">Braids (R500)</option>
                            <option value="coloring">Hair Coloring (R700)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <input type="date" class="form-control" required>
                    </div>
                    <button type="submit" class="submit-appointment-btn">Book Now 🎀</button>
                    <div class="form-footer-note">You'll receive a confirmation via WhatsApp or SMS.</div>
                </form>
            </div>

        </div>
    </div>

    <!-- Interactive Features Section (AI Preview, Before/After Slider, Calendar, Loyalty) -->
    <section class="interactive-showcase" id="interactive">
        <div class="section-header-title" style="text-align: center;">
            <h4>Interactive Experience 💖</h4>
            <h2>Explore Our Smart <span>Features*</span></h2>
        </div>

        <div class="showcase-grid">
            
            <!-- AI Hairstyle Preview Feature -->
            <div class="feature-box fade-in">
                <h3><i class="fa-solid fa-wand-magic-sparkles"></i> AI Hairstyle Preview</h3>
                <p>See how you’d look with different styles before sitting in the chair!</p>
                <div class="ai-options">
                    <div class="ai-chip active" onclick="switchAIStyle(0)">Silky Bone Straight</div>
                    <div class="ai-chip" onclick="switchAIStyle(1)">Knotless Braids</div>
                    <div class="ai-chip" onclick="switchAIStyle(2)">Honey Blonde Curls</div>
                </div>
                <div class="ai-preview-screen">
                    <img id="aiPreviewImg" src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=600" alt="AI Preview">
                    <div class="ai-badge-overlay" id="aiBadgeText">Preview Active: Silky Bone Straight</div>
                </div>
            </div>

            <!-- Before & After Image Slider Feature -->
            <div class="feature-box fade-in">
                <h3><i class="fa-solid fa-sliders"></i> Before & After Transformation</h3>
                <p>Slide to reveal the stunning transformation magic created by our stylists.</p>
                <div class="ba-slider-container" id="baContainer">
                    <img src="https://images.unsplash.com/photo-1595476108010-b9d1f67f137a?w=600" alt="Before Hair" class="ba-image-before">
                    <div class="ba-image-after-wrapper" id="baAfterWrapper">
                        <img src="https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?w=600" alt="After Hair" class="ba-image-after">
                    </div>
                    <input type="range" min="0" max="100" value="50" class="ba-slider-range" id="baRange" oninput="slideBa(this.value)">
                </div>
            </div>

            <!-- Available Appointment Calendar & Live WhatsApp booking info -->
            <div class="feature-box fade-in">
                <h3><i class="fa-solid fa-calendar-days"></i> Available Appointment Calendar</h3>
                <p>Pick an open slot directly from our real-time availability tracker.</p>
                <div style="background: var(--bg-cream); padding: 15px; border-radius: 12px; text-align: center;">
                    <p style="margin-bottom: 10px; font-weight: 600; color: #444;"><i class="fa-regular fa-clock"></i> Next Available Slots Today:</p>
                    <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
                        <span style="background: white; padding: 6px 12px; border-radius: 8px; font-size: 0.85rem; font-weight: 500;">10:00 AM</span>
                        <span style="background: var(--olive-header); color: white; padding: 6px 12px; border-radius: 8px; font-size: 0.85rem; font-weight: 500;">01:30 PM (Selected)</span>
                        <span style="background: white; padding: 6px 12px; border-radius: 8px; font-size: 0.85rem; font-weight: 500;">04:00 PM</span>
                    </div>
                </div>
            </div>

            <!-- Loyalty Points Tracker Feature -->
            <div class="feature-box fade-in">
                <h3><i class="fa-solid fa-gift"></i> VIP Loyalty Points Tracker</h3>
                <p>Earn rewards every time you style with Luxe Locks.</p>
                <div class="loyalty-card-box">
                    <div style="font-size: 0.85rem; letter-spacing: 1px;">YOUR CURRENT BALANCE</div>
                    <div class="loyalty-score">350 Points</div>
                    <div style="font-size: 0.8rem; opacity: 0.9;">150 points away from a FREE deep-conditioning treatment! 🎁</div>
                </div>
            </div>

        </div>
    </section>

    <!-- Features Banner Row -->
    <div class="features-banner">
        <div class="feature-item">
            <i class="fa-solid fa-pump-soap"></i>
            <h4>Premium Products</h4>
            <p>We use high-quality products for healthy, beautiful hair.</p>
        </div>
        <div class="feature-item">
            <i class="fa-solid fa-scissors"></i>
            <h4>Skilled Stylists</h4>
            <p>Experienced professionals who care about your look.</p>
        </div>
        <div class="feature-item">
            <i class="fa-solid fa-couch"></i>
            <h4>Clean & Cozy Salon</h4>
            <p>A relaxing space made just for you.</p>
        </div>
        <div class="feature-item">
            <i class="fa-solid fa-face-smile"></i>
            <h4>100% Satisfaction</h4>
            <p>Your happiness is our number one priority.</p>
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-brand">Luxe Locks <span style="font-size:0.9rem; font-family:'Plus Jakarta Sans'; display:block; opacity:0.8;">HAIR STUDIO +</span></div>
            <div class="copyright">Thank you for supporting small & local 🤍</div>
            <div class="social-links">
                <a href="#"><i class="fa-brands fa-instagram"></i></a>
                <a href="#"><i class="fa-brands fa-tiktok"></i></a>
                <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
            </div>
        </div>
        <div style="font-size: 0.75rem; opacity: 0.6;">© 2026 Luxe Locks Hair Studio. All rights reserved.</div>
    </footer>

    <!-- Floating Action Buttons (Stays visible while scrolling) -->
    <div class="floating-action-container">
        <a href="https://wa.me/" target="_blank" class="floating-btn whatsapp" title="Live WhatsApp Booking">
            <i class="fa-brands fa-whatsapp"></i>
        </a>
        <a href="#book-section" class="floating-btn book">
            <i class="fa-regular fa-calendar-check" style="margin-right: 6px;"></i> Book Now
        </a>
    </div>

    <!-- JavaScript code for Interactivity -->
    <script>
        // Smooth fade-in animation triggers on scroll
        const observerOptions = { threshold: 0.1 };
        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.fade-in').forEach(el => {
            observer.observe(el);
        });

        // Before & After Slider Logic
        function slideBa(val) {
            const afterWrapper = document.getElementById('baAfterWrapper');
            afterWrapper.style.width = val + '%';
        }

        // AI Hairstyle Preview switcher
        const aiStyles = [
            { img: "https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=600", name: "Preview Active: Silky Bone Straight" },
            { img: "https://images.unsplash.com/photo-1580618672591-eb180b1a973f?w=600", name: "Preview Active: Knotless Braids" },
            { img: "https://images.unsplash.com/photo-1519699047748-de8e457a634e?w=600", name: "Preview Active: Honey Blonde Curls" }
        ];

        function switchAIStyle(index) {
            document.querySelectorAll('.ai-chip').forEach((chip, idx) => {
                if(idx === index) chip.classList.add('active');
                else chip.classList.remove('active');
            });
            document.getElementById('aiPreviewImg').src = aiStyles[index].img;
            document.getElementById('aiBadgeText').innerText = aiStyles[index].name;
        }

        // Booking Form Submission Handler
        function handleBooking(e) {
            e.preventDefault();
            alert("Appointment request submitted successfully! We are redirecting you to confirmation.");
            document.getElementById('bookingForm').reset();
        }
    </script>
</body>
</html>
